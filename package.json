{
  "name": "deus",
  "version": "2.0.0",
  "description": "DEUS Cognitive Runtime — NestJS + SurrealDB",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/sidecar-main.js",
    "start:dev": "tsx watch src/sidecar-main.ts",
    "start:full": "node dist/main.js",
    "start:full:dev": "tsx watch src/main.ts",
    "cli": "node dist/cli.js",
    "cli:dev": "tsx src/cli.ts",
    "deus:db": "surreal start surrealkv://deus.db --user root --pass root --bind 127.0.0.1:8000",
    "deus:bootstrap": "node dist/cli.js bootstrap",
    "deus:health": "node dist/cli.js health",
    "deus:beliefs:extract": "node dist/cli.js beliefs:extract",
    "deus:beliefs:decay": "node dist/cli.js beliefs:decay",
    "deus:beliefs:contradictions": "node dist/cli.js beliefs:contradictions",
    "deus:beliefs:promote": "node dist/cli.js beliefs:promote",
    "deus:beliefs:cycle": "node dist/cli.js beliefs:cycle",
    "deus:memory:log": "node dist/cli.js memory:log",
    "deus:memory:aggregate": "node dist/cli.js memory:aggregate",
    "deus:introspect": "node dist/cli.js introspect",
    "deus:nightly": "node dist/cli.js nightly",
    "deus:world-model": "node dist/cli.js world-model",
    "deus:policy:evaluate": "node dist/cli.js policy:evaluate",
    "deus:metrics": "node dist/cli.js metrics",
    "deus:metrics:history": "node dist/cli.js metrics:history",
    "deus:diagnose": "node dist/cli.js diagnose",
    "deus:benchmark": "node dist/cli.js benchmark",
    "deus:improve": "node dist/cli.js improve",
    "deus:improvements": "node dist/cli.js improvements",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilisk-labs/openclaw-deus.git"
  },
  "keywords": [
    "deus",
    "cognitive-runtime",
    "nestjs",
    "surrealdb"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/basilisk-labs/openclaw-deus/issues"
  },
  "homepage": "https://github.com/basilisk-labs/openclaw-deus#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.1.0",
    "nest-commander": "^3.15.0",
    "neverthrow": "^7.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "surrealdb": "^1.3.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.16.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
